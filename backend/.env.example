MONGO_URI='mongodb://localhost:27017/travelmemory'
PORT=3001
# Comma separated list of frontend origins allowed to call the API
CORS_ORIGIN=http://localhost:3000
# Where uploaded images are stored and the max image size
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
# Number of reverse proxies in front of the API (1 when behind nginx / a load balancer)
TRUST_PROXY=0
